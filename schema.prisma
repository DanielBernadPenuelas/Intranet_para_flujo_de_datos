
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Member {
  id        Int       @id @default(autoincrement())
  name      String
  status    String
  payments  Payment[]
  createdAt DateTime  @default(now())
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  date      DateTime
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
}